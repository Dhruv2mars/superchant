{
  "name": "superchant",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/material-symbols": "^0.4.51",
    "@expo/ui": "~58.0.23",
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@types/bun": "^1.4.4",
    "@types/react": "~19.3.0",
    "oxlint": "1.90.0",
    "sf-symbols-typescript": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "bun run test:tz-utc && bun run test:tz-ny && bun run test:tz-in",
    "test:tz-utc": "TZ=UTC bun test src",
    "test:tz-ny": "TZ=America/New_York bun test src",
    "test:tz-in": "TZ=Asia/Kolkata bun test src",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --clean",
    "test:swift": "swiftc -O modules/superchant-native/ios/ChantModel.swift modules/superchant-native/swift-tests/main.swift -o /tmp/superchant-swift-vectors && /tmp/superchant-swift-vectors src/core/__fixtures__/golden.json",
    "lint": "oxlint --deny-warnings"
  },
  "private": true
}
