{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EAS_UPDATE_CHANNEL": "development" },
      "ios": { "simulator": true }
    },
    "simulator": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EAS_UPDATE_CHANNEL": "preview" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EAS_UPDATE_CHANNEL": "preview" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "env": { "EAS_UPDATE_CHANNEL": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
