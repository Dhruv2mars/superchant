<resources>
    <string name="app_name">SuperChant</string>
    <string name="notification_channel_name">Chanting Session</string>
    <string name="notification_channel_description">Shows your active chanting session progress</string>
    <string name="action_stop">Stop</string>
    <string name="action_pause">Pause</string>
    <string name="action_resume">Resume</string>
    
    <!-- Accessibility Service -->
    <string name="accessibility_service_label">SuperChant Volume Counter</string>
    <string name="accessibility_service_summary">Allows volume buttons to count chants without changing volume</string>
    <string name="accessibility_service_description">SuperChant uses this accessibility service to detect volume button presses during your chanting session.\n\nWhen enabled, pressing volume up or down will increment your count instead of changing the volume.\n\nThis service only activates when you start a chanting session and has no access to your screen content or other apps.</string>
    
    <!-- Accessibility Setup -->
    <string name="accessibility_setup_title">Enable Volume Counter</string>
    <string name="accessibility_setup_message">To count chants with volume buttons, SuperChant needs accessibility permission.\n\nThis allows the app to detect button presses without changing your volume.</string>
    <string name="accessibility_setup_instructions">1. Tap \"Open Settings\" below\n2. Find \"SuperChant Volume Counter\"\n3. Toggle it ON\n4. Return to the app</string>
    <string name="open_settings">Open Settings</string>
    
    <!-- Restricted Settings (Android 13+) -->
    <string name="restricted_settings_title">Setup Required</string>
    <string name="restricted_settings_message">Since this app was installed outside the Play Store, you may need to allow restricted settings before enabling accessibility.</string>
    <string name="restricted_settings_step1">If the toggle is blocked:</string>
    <string name="restricted_settings_step1_desc">Open App Info, look for \"Allow restricted settings\" in the menu or under permissions, enable it, then return here.</string>
    <string name="restricted_settings_step2">Enable Accessibility</string>
    <string name="restricted_settings_step2_desc">Find \"SuperChant Volume Counter\" in the list and turn it ON</string>
    <string name="open_app_info">Open App Info</string>
    <string name="enable_accessibility">Open Accessibility Settings</string>
